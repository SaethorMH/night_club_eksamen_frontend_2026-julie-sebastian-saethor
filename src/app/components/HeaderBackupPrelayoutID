"use client";
import Link from "next/link";
import Logo from "./Logo";
import { motion } from "motion/react";
import Image from "next/image";
import { usePathname } from "next/navigation";
import { useState } from "react";
const MotionImage = motion.create(Image);

export default function Header() {
  const currentPath = usePathname();

  return (
    <header className=" @container sticky top-0 z-50 bg-(--black) py-3 border-2  border-border-header ">
      <article className=" flex justify-evenly place-items-center m-auto gap-8  ">
        <Logo />

        <button popoverTarget="popover" className="@3xl:hidden ">
          ≡
        </button>
        <div
          id="popover"
          popover="auto"
          className="   bg-(--black) opacity-70 w-screen h-screen open:grid grid-cols-1 text-center gap-1"
        >
          <button
            popoverTarget="popover"
            popoverTargetAction="hide"
            className=""
          >
            X
          </button>

          <Link href={"/"}>Home</Link>
          <Link href={"/"}>Events</Link>
          <Link href={"/"}>Book Table</Link>
          <Link href={"/"}>Contact us</Link>
        </div>

        <nav className=" hidden @3xl:flex justify-evenly place-items-center gap-10 uppercase   ">
          <div className="relative ">
            <RollingLink
              href="/"
              ariacurrent={currentPath === "/" ? "page" : undefined}
            >
              Home
            </RollingLink>
            {currentPath === "/" && (
              <MotionImage
                src="/assets/bottom_line_slider/bottom_line2.png"
                width={48}
                height={2}
                alt="slider"
                className="absolute mx-auto -bottom-2  "
              />
            )}
          </div>
          <div className="relative">
            <RollingLink
              href="/events/"
              ariacurrent={
                currentPath.startsWith("/events") ? "page" : undefined
              }
            >
              Events
            </RollingLink>
            {currentPath.startsWith("/events") && (
              <MotionImage
                src="/assets/bottom_line_slider/bottom_line2.png"
                width={48}
                height={2}
                alt="slider"
                className="absolute mx-auto -bottom-2  "
              />
            )}
          </div>
          <div className="relative">
            <RollingLink
              href="/booktable/"
              ariacurrent={
                currentPath.startsWith("/booktable") ? "page" : undefined
              }
            >
              Book table
            </RollingLink>
          </div>
          {currentPath.startsWith("/booktable") && (
            <MotionImage
              src="/assets/bottom_line_slider/bottom_line2.png"
              width={48}
              height={2}
              alt="slider"
              className="absolute mx-auto -bottom-2  "
            />
          )}

          <div className="relative">
            <RollingLink
              href="/contact/"
              ariacurrent={
                currentPath.startsWith("/contact/") ? "page" : undefined
              }
            >
              Contact us
            </RollingLink>
            {currentPath.startsWith("/contact") && (
              <MotionImage
                src="/assets/bottom_line_slider/bottom_line2.png"
                width={48}
                height={2}
                alt="slider"
                className="absolute mx-auto -bottom-2  "
              />
            )}
          </div>
        </nav>
      </article>
    </header>
  );
}

const RollingLink = ({
  children,
  href,
  ariacurrent,
}: {
  children: string;
  href: string;
  ariacurrent?: boolean;
}) => {
  const duration = 0.25;
  const stagger = 0.025;

  return (
    <>
      <motion.a
        initial="initial"
        whileHover="hovering"
        href={href}
        className="relative block overflow-hidden whitespace-nowrap "
      >
        <div>
          {children.split("").map((letter, index) => {
            return (
              <motion.span
                variants={{
                  initial: {
                    y: 0,
                    color: ariacurrent ? "var(--pink)" : "currentcolor",
                  },
                  hovering: { y: "-100%", color: "var(--pink)" },
                }}
                transition={{
                  duration: duration,
                  ease: "easeInOut",
                  delay: stagger * index,
                }}
                className="inline-block"
                key={index}
              >
                {letter}
              </motion.span>
            );
          })}
        </div>

        <div className="absolute inset-0  ">
          {children.split("").map((letter, index) => {
            return (
              <motion.span
                variants={{
                  initial: { y: "100%" },
                  hovering: { y: 0, color: "var(--pink)" },
                }}
                transition={{
                  duration: duration,
                  ease: "easeInOut",
                  delay: stagger * index,
                }}
                className="inline-block"
                key={index}
              >
                {letter}
              </motion.span>
            );
          })}
        </div>
      </motion.a>
    </>
  );
};
